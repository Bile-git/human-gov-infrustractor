# Terraform working directory and provider cache
.terraform/

# Terraform state and backups
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.lock.info

# Variable and plan files (may contain sensitive values)
*.tfvars
*.tfvars.json
*.tfplan
*.plan

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
